{
  "version": 2,
  "mode": "proof-graph",
  "defaultBase": "main",
  "states": [
    "IMPLEMENTING",
    "LOCAL_PROVEN",
    "REMOTE_PROVEN",
    "COMPOSITION_PROVEN",
    "POLICY_SATISFIED",
    "MERGE_READY",
    "MERGED",
    "POST_MERGE_PROVEN",
    "RELEASE_CANDIDATE",
    "STAGING_PROVEN",
    "CERTIFIED",
    "RELEASED",
    "PRODUCTION_VERIFIED"
  ],
  "authorities": {
    "worker": ["implement", "test", "push", "open_pr"],
    "integrator": [
      "reconcile",
      "composition_test",
      "mark_merge_ready",
      "enable_auto_merge"
    ],
    "release": ["certify_exact_head", "promote", "rollback"],
    "orchestrator": [
      "decompose",
      "schedule",
      "assign",
      "prioritize",
      "maintain_changeset_registry"
    ]
  },
  "invariants": [
    "no-direct-main-feature-work",
    "exact-head-before-merge",
    "exact-candidate-sha-before-production",
    "payments-financial-authority-must-not-be-bypassed",
    "evidence-must-identify-input-sha",
    "required-skipped-evidence-is-failure",
    "auto-merge-only-after-merge-ready",
    "external-effects-require-verifiable-evidence",
    "termux-heartbeat-singleton",
    "zero-active-expired-claims",
    "single-integration-train-authority",
    "single-release-candidate",
    "trusted-validator-independence",
    "staging-certified-artifact-identity",
    "production-certified-artifact-identity",
    "staging-before-production",
    "single-financial-authority",
    "tenant-isolation-server-side",
    "destination-isolation-server-side",
    "no-http-200-degraded-acceptance",
    "runtime-release-identity",
    "changeset-v2-contract",
    "control-projection-terminal-main-recheck",
    "critical-evidence-candidate-binding",
    "capability-lease-secondary-to-claim",
    "context-pack-candidate-binding",
    "local-admission-before-remote-proof",
    "candidate-mutation-invalidates-dependent-evidence",
    "review-findings-zero-before-merge-ready",
    "workspace-bootstrap-before-worker-execution",
    "post-merge-reconciliation-before-dependent-dispatch"
  ],
  "branchPrefixes": ["agent/", "feat/", "fix/", "infra/", "wave/", "chore/"],
  "pullRequestPolicy": {
    "developAsDraft": true,
    "readyOnlyAfterRemoteProof": true,
    "preferSmallSemanticChanges": true,
    "autoMergeOnlyAfterMergeReady": true,
    "freezeHeadAfterCertification": true,
    "batchReviewFixesBeforeRemoteProof": true,
    "rerunOnlyInvalidatedProof": true
  },
  "rollout": {
    "registryEnforcement": "shadow-until-first-wave-closes",
    "proofBundle": "required-for-v2-registered-changesets",
    "semanticOwnership": "enforced",
    "integrationQueue": "shadow",
    "shadowMain": "shadow",
    "progressiveDelivery": "disabled-until-capability-verified",
    "changeSetV2": "active-for-control-plane-block-b1"
  },
  "capabilities": {
    "changeSetV2": "active-for-control-plane-block-b",
    "capabilityLeases": "task-local-enforced-global-claim-authoritative",
    "contextPacks": "active-for-v2-tasks"
  }
}
