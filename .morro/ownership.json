{
  "version": 2,
  "domains": [
    {
      "id": "map",
      "pathPrefixes": [
        "apps/morro-digital-platform/src/map/",
        "apps/morro-digital-platform/public/"
      ],
      "contracts": []
    },
    {
      "id": "commerce",
      "pathPrefixes": ["packages/commerce/", "services/commerce/"],
      "contracts": ["commerce-offering-identity", "reservation-capacity"]
    },
    {
      "id": "ticketing",
      "pathPrefixes": [
        "packages/ticketing/",
        "services/ticketing/",
        "tooling/ticketing/"
      ],
      "contracts": ["ticket-fulfillment"]
    },
    {
      "id": "ordering",
      "pathPrefixes": ["packages/ordering/", "services/ordering/"],
      "contracts": ["verified-payment-outcome"]
    },
    {
      "id": "payments",
      "pathPrefixes": [
        "packages/financial/",
        "services/financial/",
        "tooling/payments/"
      ],
      "contracts": ["verified-payment-outcome"]
    },
    {
      "id": "auth",
      "pathPrefixes": ["packages/auth/", "services/auth/"],
      "contracts": ["platform-authz"]
    },
    {
      "id": "business",
      "pathPrefixes": ["packages/business/", "services/business/"],
      "contracts": []
    },
    {
      "id": "ci-release",
      "pathPrefixes": [
        ".github/workflows/",
        "tooling/quality/",
        "tooling/fabric/",
        ".morro/"
      ],
      "contracts": []
    }
  ],
  "collisionPolicy": "serialize overlapping paths, contracts, events, tables, routes or auth capabilities unless dependencies are explicitly stacked"
}
