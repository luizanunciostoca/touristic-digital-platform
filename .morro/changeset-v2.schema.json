{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TDP ChangeSet V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baseSha",
    "branch",
    "state",
    "risk",
    "scope",
    "owns",
    "reads",
    "produces",
    "database",
    "auth",
    "dependencies",
    "requiredEvidence",
    "requiredCapabilities",
    "contextPack",
    "proof",
    "stopAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^MD-[A-Z0-9-]+$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "state": {
      "enum": [
        "IMPLEMENTING",
        "LOCAL_PROVEN",
        "REMOTE_PROVEN",
        "COMPOSITION_PROVEN",
        "POLICY_SATISFIED",
        "MERGE_READY",
        "MERGED"
      ]
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "scope": {
      "enum": [
        "PLATFORM",
        "DESTINATION:MORRO",
        "DESTINATION:ITACARE",
        "CROSS_DESTINATION"
      ]
    },
    "owns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "contracts"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts"],
      "properties": {
        "contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "produces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "routes"],
      "properties": {
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MD-[A-Z0-9-]+$"
      }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._/-]{0,159}$"
      }
    },
    "contextPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "include"],
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "changeset",
              "git-identity",
              "ownership",
              "contracts",
              "dependencies",
              "proof-plan"
            ]
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "commands", "requiredRemoteEvidence"],
      "properties": {
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCommands", "maxSeconds"],
          "properties": {
            "maxCommands": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "argv", "timeoutSeconds"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "argv": {
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800
              }
            }
          }
        },
        "requiredRemoteEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stopAt": {
      "const": "REMOTE_PROVEN"
    }
  }
}
