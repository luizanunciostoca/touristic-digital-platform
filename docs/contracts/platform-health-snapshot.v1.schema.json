{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touristic.digital/contracts/platform-health-snapshot.v1.schema.json",
  "title": "Platform Health Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "service",
    "status",
    "readiness",
    "checkedAt",
    "destinationId",
    "correlationId",
    "checks"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "service": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unhealthy"]
    },
    "readiness": {
      "type": "string",
      "enum": ["ready", "not_ready"]
    },
    "checkedAt": { "type": "string", "format": "date-time" },
    "destinationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "critical"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "fail"]
          },
          "critical": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
