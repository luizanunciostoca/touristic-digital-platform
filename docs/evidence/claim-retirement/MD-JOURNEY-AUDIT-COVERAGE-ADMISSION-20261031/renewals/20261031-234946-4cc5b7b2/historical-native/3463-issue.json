  "body": "{\"version\":2,\"confirm\":\"EXECUTE\",\"id\":\"coverage-retirement-auth-diagnosis-20261031-cf947\",\"target\":\"termux\",\"cwd\":\"~\",\"timeout_seconds\":300,\"command\":\"set -euo pipefail\\npython3 - <<'TDP_DIAG'\\nfrom pathlib import Path\\nimport subprocess,json,os\\nroot=Path('/data/data/com.termux/files/home/.cache/tdp-retirement-proof-yt7rb4qr')\\nqa=root/'frozen-candidate'\\nhead='e78f891eaea58ce850d154426420ea5e0c3dcdc1'\\nbase='d979b9813c1ab40b96dee64616b9f7d08a7c0d07'\\ndef run(a,**kw):\\n p=subprocess.run(a,text=True,capture_output=True,timeout=30,**kw)\\n if p.returncode:raise RuntimeError('DIAG_COMMAND_FAILED:'+str(a[:2]))\\n return p.stdout.strip()\\nassert run(['git','-C',str(qa),'rev-parse','HEAD'])==head\\nassert run(['git','-C',str(qa),'status','--porcelain=v1','--untracked-files=all'])==''\\nrunner=root/'auth-runtime-diagnostic.mjs'\\nrunner.write_text(\\\"\\\"\\\"import {runGithubAuthExec} from '\\\"\\\"\\\"+(qa/'tooling/workspace/github-auth-exec.mjs').as_uri()+\\\"\\\"\\\"';\\nimport fs from 'node:fs';\\nfor(const runtime of ['native','debian-proot']){\\n const started=Date.now();\\n try{\\n  const result=runGithubAuthExec({runtime,root:process.argv[2],repository:'luizanunciostoca/touristic-digital-platform',expectedHead:'e78f891eaea58ce850d154426420ea5e0c3dcdc1',expectedMain:'d979b9813c1ab40b96dee64616b9f7d08a7c0d07',command:'node',args:['--input-type=module','-e','console.log(JSON.stringify({kind:\\\"AUTH_RUNTIME_PROBE\\\",node:process.version,platform:process.platform,arch:process.arch,cwd:process.cwd(),uid:process.getuid?.()}))'],timeoutMs:15000});\\n  fs.writeFileSync(process.argv[3]+'/diagnostic-'+runtime+'.json',JSON.stringify(result,null,2));\\n  console.log(JSON.stringify({runtime,elapsedMs:Date.now()-started,exitCode:result.exitCode,stdout:result.stdout,stderr:result.stderr}));\\n }catch(e){console.log(JSON.stringify({runtime,elapsedMs:Date.now()-started,error:e.message}));process.exitCode=1}\\n}\\n\\\"\\\"\\\")\\np=subp