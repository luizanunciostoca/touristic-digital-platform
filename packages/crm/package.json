{
  "name": "@touristic/crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@touristic/auth": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./authorization": {
      "types": "./src/authorization.ts",
      "node": "./dist/authorization.js",
      "default": "./src/authorization.ts"
    },
    "./leads-boundary": {
      "types": "./src/leads-boundary.ts",
      "node": "./dist/leads-boundary.js",
      "default": "./src/leads-boundary.ts"
    },
    "./meetings-boundary": {
      "types": "./src/meetings-boundary.ts",
      "node": "./dist/meetings-boundary.js",
      "default": "./src/meetings-boundary.ts"
    },
    "./proposals-boundary": {
      "types": "./src/proposals-boundary.ts",
      "node": "./dist/proposals-boundary.js",
      "default": "./src/proposals-boundary.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
