{
  "name": "@touristic/ordering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@touristic/financial": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./subscription": {
      "types": "./src/subscription.ts",
      "node": "./dist/subscription.js",
      "default": "./src/subscription.ts"
    },
    "./subscription-application": {
      "types": "./src/subscription-application.ts",
      "node": "./dist/subscription-application.js",
      "default": "./src/subscription-application.ts"
    },
    "./subscription-activation-application": {
      "types": "./src/subscription-activation-application.ts",
      "node": "./dist/subscription-activation-application.js",
      "default": "./src/subscription-activation-application.ts"
    },
    "./ticketing-reservation": {
      "types": "./src/ticketing-reservation.ts",
      "node": "./dist/ticketing-reservation.js",
      "default": "./src/ticketing-reservation.ts"
    },
    "./ticketing-checkout": {
      "types": "./src/ticketing-checkout.ts",
      "node": "./dist/ticketing-checkout.js",
      "default": "./src/ticketing-checkout.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
