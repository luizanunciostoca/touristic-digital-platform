{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morro.digital/schemas/tdp-max/evidence.schema.json",
  "title": "TDP-MAX evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseSha",
    "candidateSha",
    "validatorSha",
    "exactHead",
    "environment",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "validatorSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "exactHead": { "const": true },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "observedAt"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "authority", "inputSha"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "authority": { "type": "string", "minLength": 1 },
          "inputSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
