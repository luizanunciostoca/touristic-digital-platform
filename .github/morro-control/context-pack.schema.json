{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TDP Context Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "changeSetId",
    "baseSha",
    "candidateSha",
    "treeSha",
    "branch",
    "scope",
    "ownership",
    "contracts",
    "dependencies",
    "capabilityLeaseIds",
    "proofPlan",
    "generatedAt",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "TDP_CONTEXT_PACK"
    },
    "changeSetId": {
      "type": "string",
      "pattern": "^MD-[A-Z0-9-]+$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "treeSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "type": "object"
    },
    "contracts": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilityLeaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lease-"
      }
    },
    "proofPlan": {
      "type": "object"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
