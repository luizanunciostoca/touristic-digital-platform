{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TDP Context Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "changeSetId",
    "changeSetDigest",
    "baseSha",
    "candidateSha",
    "treeSha",
    "branch",
    "scope",
    "owner",
    "ownership",
    "contracts",
    "dependencies",
    "capabilityLeaseIds",
    "proofPlan",
    "generatedAt",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "TDP_CONTEXT_PACK"
    },
    "changeSetId": {
      "type": "string",
      "pattern": "^MD-[A-Z0-9-]+$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "treeSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "contracts"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "owns"],
      "properties": {
        "reads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MD-[A-Z0-9-]+$"
      }
    },
    "capabilityLeaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lease-[A-Za-z0-9._-]{1,120}$"
      }
    },
    "proofPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandIds",
        "requiredEvidence",
        "requiredRemoteEvidence",
        "budget"
      ],
      "properties": {
        "commandIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredRemoteEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCommands", "maxSeconds"],
          "properties": {
            "maxCommands": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "changeSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,120}$"
    }
  }
}
