{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TDP Failure Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentId",
    "occurrenceId",
    "fingerprint",
    "failureClass",
    "severity",
    "domain",
    "environment",
    "expected",
    "observed",
    "sources",
    "state",
    "preventionState",
    "firstOccurrence",
    "lastOccurrence",
    "metrics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "incidentId": { "type": "string", "minLength": 1 },
    "occurrenceId": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rootCauseFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "failureClass": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "operation": { "type": ["string", "null"] },
    "domain": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "expected": { "type": "string" },
    "observed": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "object" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "state": {
      "enum": [
        "OBSERVED",
        "REPRODUCED",
        "ROOT_CAUSE_CONFIRMED",
        "PREVENTION_PROPOSED",
        "PREVENTION_IMPLEMENTED",
        "PREVENTION_PROVEN",
        "ACTIVE_GUARD",
        "TRANSIENT_RESOLVED",
        "BLOCKED",
        "UNKNOWN_REQUIRES_INVESTIGATION",
        "FALSE_POSITIVE",
        "SUPERSEDED"
      ]
    },
    "rootCause": { "type": ["string", "null"] },
    "preventionState": { "type": "string" },
    "guardId": { "type": ["string", "null"] },
    "firstOccurrence": { "type": "string", "format": "date-time" },
    "lastOccurrence": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "object",
      "required": [
        "occurrencesBeforeGuard",
        "occurrencesAfterGuard",
        "preventedCount",
        "falsePositiveCount"
      ],
      "properties": {
        "occurrencesBeforeGuard": { "type": "integer", "minimum": 0 },
        "occurrencesAfterGuard": { "type": "integer", "minimum": 0 },
        "preventedCount": { "type": "integer", "minimum": 0 },
        "falsePositiveCount": { "type": "integer", "minimum": 0 },
        "lastGuardTrigger": { "type": ["string", "null"] },
        "meanTimeToRootCause": { "type": ["number", "null"], "minimum": 0 },
        "meanTimeToPrevention": { "type": ["number", "null"], "minimum": 0 },
        "guardEffectiveness": {
          "enum": [
            "EFFECTIVE",
            "PARTIALLY_EFFECTIVE",
            "INEFFECTIVE",
            "OBSOLETE",
            "UNKNOWN"
          ]
        }
      }
    }
  }
}
