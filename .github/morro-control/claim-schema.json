{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morro Digital ChangeSet Claim",
  "type": "object",
  "required": [
    "owner",
    "reviewer",
    "branch",
    "baseSha",
    "paths",
    "domains",
    "risk",
    "status",
    "expiresAt"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "status": {
      "enum": [
        "CLAIMED",
        "IMPLEMENTING",
        "LOCAL_PROVEN",
        "REMOTE_PROVEN",
        "PROOF_ACCEPTED",
        "INTEGRATION_READY"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
