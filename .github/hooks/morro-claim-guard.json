{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "^(create|edit|str_replace_editor|apply_patch|bash)$",
        "bash": "node .github/hooks/morro-pretool-guard.mjs",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
