[mysqld]
# Production starts on a 512 MiB Render starter private service.
# Keep deterministic headroom; raise the service plan before increasing these limits.
performance_schema=OFF
mysqlx=OFF
innodb_buffer_pool_size=96M
innodb_log_buffer_size=8M
innodb_flush_method=O_DIRECT
max_connections=40
thread_cache_size=8
table_open_cache=256
table_definition_cache=400
tmp_table_size=8M
max_heap_table_size=8M
key_buffer_size=8M
skip_name_resolve=ON
