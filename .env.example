# -----------------------------------------------------------------------------
# Mapbox — public browser configuration
# -----------------------------------------------------------------------------
# Use a URL-restricted, least-privilege public token.
VITE_MAPBOX_ACCESS_TOKEN=

# Preserve the approved V1 style URL during visual-equivalence work.
VITE_MAPBOX_STYLE=

# DOM container rendered by the Morro Digital Home.
VITE_MAPBOX_CONTAINER_ID=map

# Initial zoom must remain between 0 and 24.
VITE_MAPBOX_INITIAL_ZOOM=14

# -----------------------------------------------------------------------------
# Ordering / Financial — server-only durable persistence
# -----------------------------------------------------------------------------
# Keep these credentials outside browser bundles. Use distinct databases/users
# with least privilege and TLS in deployed environments. Pointing both domains
# at the same schema defeats the intended ownership and failure isolation.
ORDERING_DATABASE_URL=
FINANCIAL_DATABASE_URL=

# M138 authoritative price catalog. Missing, malformed, duplicate or zero-value
# plans fail closed. Values are integer minor units; never copy browser amounts.
# Schema:
# {"version":"plans_2026_08","plans":[{"id":"growth","name":"Crescimento","minorUnits":49900,"currency":"BRL"}]}
ORDERING_PRICING_CATALOG_JSON=

# M139 versioned checkout HTTP/Auth/security boundary. All values are server-only.
# The runtime remains unavailable unless both databases, the price catalog and
# every security setting below are valid.
PAYMENTS_DESTINATION_ID=morro-de-sao-paulo

# Comma-separated exact origins. Production accepts HTTPS only; paths do not
# broaden the origin match.
PAYMENTS_RETURN_URL_ORIGINS=https://morro.digital

# Independent secrets with at least 32 characters. The status secret derives a
# deterministic opaque capability, but only its SHA-256 hash is persisted. The
# handoff secret verifies short-lived Business-issued guest capabilities.
PAYMENTS_STATUS_TOKEN_SECRET=
PAYMENTS_HANDOFF_SECRET=

# Optional, 10 minutes to 7 days. Default: 86400 (24 hours).
PAYMENTS_STATUS_TOKEN_TTL_SECONDS=86400

# Provider selector. Keep sandbox for deterministic/local contracts. Set
# mercado_pago only in a server-side deployed environment with real/test MP
# credentials configured outside GitHub.
PAYMENTS_PROVIDER_MODE=sandbox

# M140 sandbox checkout provider. These values are server-only. Configuration
# fails closed unless endpoint, bearer token, checkout-origin allowlist and
# webhook target are all valid.
PAYMENTS_SANDBOX_PROVIDER_BASE_URL=
PAYMENTS_SANDBOX_PROVIDER_API_TOKEN=
PAYMENTS_SANDBOX_CHECKOUT_ORIGINS=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# Mercado Pago Checkout Pro provider. The adapter talks only to the fixed
# https://api.mercadopago.com API base. Never put these secrets in GitHub or in
# browser/VITE variables.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Exact HTTPS checkout origins accepted from init_point/sandbox_init_point.
# Configure from the URLs returned by the Mercado Pago account being validated.
MERCADO_PAGO_CHECKOUT_ORIGINS=

# production => use init_point; test => use sandbox_init_point.
MERCADO_PAGO_CHECKOUT_MODE=test

# Temporary V1 -> V2 Render migration aliases. During cutover the V2 adapter can
# read the already-provisioned V1 secrets under these old names. Prefer copying
# them to the canonical MERCADO_PAGO_* variables after provider validation and
# then remove these aliases from the V2 service.
BUSINESS_PAYMENT_API_TOKEN=
BUSINESS_PAYMENT_WEBHOOK_SECRET=

PAYMENTS_PROVIDER_TIMEOUT_MS=8000

# In-memory checkout rate limiting is safe only with one runtime replica.
# Multi-replica deployments require a distributed atomic rate-limit store.
PAYMENTS_RUNTIME_REPLICA_COUNT=1
PAYMENTS_RATE_LIMIT_DISTRIBUTED_STORE_CONFIGURED=false

# M152 bounded retry policy. Attempts are limited to 1–2 and apply only to
# network/timeout, HTTP 408, 429 and 5xx. Mutating requests are retried only when
# an explicit Idempotency-Key is present; semantic 4xx and invalid 2xx payloads
# are never retried. Mercado Pago preference creation is deliberately single-
# attempt because Checkout Pro preference creation does not provide the same
# documented idempotency contract as refunds.
PAYMENTS_PROVIDER_MAX_ATTEMPTS=2
PAYMENTS_PROVIDER_RETRY_BASE_MS=100

# Exact public callback implemented in M141. The legacy pathname is retained
# during provider migration so existing Payments contracts remain stable.
PAYMENTS_WEBHOOK_URL=https://example.invalid/api/payments/v1/webhooks/sandbox

# Optional signed timestamp window, 60–900 seconds.
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# OpenAI Assistant — server-only paid-provider governance
# -----------------------------------------------------------------------------
# A key alone does NOT enable paid requests. The billing guard below must also
# be explicitly configured; otherwise the Assistant fails closed with HTTP 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bind the copied token rates to exactly the model that will be called. Keep
# this identical to OPENAI_MODEL; prefer a pinned model snapshot when available.
# A mismatch or missing value fails closed before any paid provider request.
OPENAI_PRICING_MODEL=gpt-4o-mini

# Set true only after a hard spending/billing limit has been configured in the
# provider account. This is an explicit operator acknowledgement, not a limit by
# itself.
OPENAI_PROVIDER_HARD_LIMIT_CONFIRMED=false

# Copy the CURRENT provider rates for the configured model. Do not hard-code
# stale pricing in application source. These values are used only for runtime
# cost accounting and internal budget enforcement.
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=

# Internal application ceilings. Requests are denied before the provider call
# when the reservation would cross either ceiling.
OPENAI_DAILY_COST_LIMIT_USD=
OPENAI_MONTHLY_COST_LIMIT_USD=

# Conservative amount reserved before each provider request. It must be >= the
# runtime-computed floor derived from configured rates, 2x the 64 KiB body byte
# cap as a prompt-token envelope, and the 600-token output cap. Lower values
# fail closed rather than permitting under-reserved concurrent spend. If usage
# is missing, the reservation is charged instead of assuming zero cost.
OPENAI_REQUEST_RESERVE_USD=

# Independent protection against parallel request bursts. This value is strict:
# missing, zero or malformed configuration keeps paid-provider governance closed.
OPENAI_MAX_CONCURRENCY=4

# The current durable governor supports exactly one paid runtime replica. Set this
# explicitly to 1. Values above 1 fail closed until a distributed atomic state
# store is implemented; do not use this flag to pretend a multi-replica deploy is
# safe.
OPENAI_RUNTIME_REPLICA_COUNT=1

# Writable path on durable server-side storage. The governor persists spend and
# reservations before provider calls using atomic file replacement. Do not point
# this at an ephemeral /tmp filesystem in production. Missing or unreadable state
# fails closed; orphaned reservations after restart are charged conservatively.
# Never mount the same file into two simultaneously active paid replicas.
OPENAI_GOVERNANCE_STATE_FILE=

# -----------------------------------------------------------------------------
# Affiliates — M154 durable persistence/application boundary
# -----------------------------------------------------------------------------
AFFILIATES_DATABASE_URL=mysql://user:password@localhost:3306/touristic_affiliates
AFFILIATES_DATABASE_POOL_SIZE=8
